rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && request.auth.uid == 'ejd0cPQ5Lgd3Fhpzl6hvj6hLlXi2';
    }
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function text(value, max) {
      return value is string && value.size() <= max;
    }
    match /usuarios/{uid} {
      allow get: if admin() || owner(uid);
      allow list: if admin();
      allow create: if admin() || (owner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'nombre', 'proveedor', 'banned', 'fechaRegistro'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.get('email', 'Sin Correo')
        && text(request.resource.data.nombre, 128)
        && text(request.resource.data.proveedor, 40)
        && request.resource.data.banned == false
        && request.resource.data.fechaRegistro == request.time);
      allow update: if admin() || (owner(uid)
        && resource.data.banned != true
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nombre', 'ultimoMensajeAt', 'unreadAdmin'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['nombre'])
          || text(request.resource.data.nombre, 128))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ultimoMensajeAt'])
          || request.resource.data.ultimoMensajeAt == request.time)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['unreadAdmin'])
          || request.resource.data.unreadAdmin == true));
      allow delete: if admin();
    }
    match /chats/{uid}/mensajes/{message} {
      allow read: if admin() || owner(uid);
      allow create: if (admin() || owner(uid))
        && request.resource.data.keys().hasOnly(['texto', 'sender', 'timestamp'])
        && text(request.resource.data.texto, 4000)
        && request.resource.data.texto.size() > 0
        && request.resource.data.timestamp == request.time
        && ((admin() && request.resource.data.sender == 'admin')
          || (owner(uid) && request.resource.data.sender == 'user'));
      allow update, delete: if false;
    }
    match /configuracion/general {
      allow read: if true;
      allow write: if admin();
    }
    match /estadisticas/general {
      allow read: if admin();
      allow create: if request.resource.data.keys().hasOnly(['visitas'])
        && request.resource.data.visitas == 1;
      allow update: if request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(['visitas'])
        && request.resource.data.visitas is int
        && request.resource.data.visitas == resource.data.visitas + 1;
      allow delete: if false;
    }
    match /visitas_log/{visit} {
      allow read: if admin();
      allow create: if request.resource.data.keys()
        .hasOnly(['fecha', 'dispositivo', 'plataforma'])
        && request.resource.data.fecha == request.time
        && request.resource.data.dispositivo in ['Móvil', 'PC']
        && text(request.resource.data.plataforma, 120);
      allow update, delete: if false;
    }
    match /walletAccounts/{document=**} {
      allow read, write: if false;
    }
    match /walletTransactions/{document=**} {
      allow read, write: if false;
    }
    match /walletSettings/{document=**} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
